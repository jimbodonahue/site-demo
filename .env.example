# Copy to .env on the server and edit values.
#   cp .env.example .env

DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
SERVER=production

# Hosts / CSRF — replace YOURUSERNAME with your PythonAnywhere username
ALLOWED_HOSTS=YOURUSERNAME.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=https://YOURUSERNAME.pythonanywhere.com

# Database: sqlite is simplest on PythonAnywhere free accounts
DB_ENGINE=sqlite

# If you switch to PythonAnywhere MySQL later:
# DB_ENGINE=mysql
# DB_NAME=YOURUSERNAME$dbname
# DB_USER=YOURUSERNAME
# DB_PWD=your-mysql-password
# DB_HOST=YOURUSERNAME.mysql.pythonanywhere-services.com
# DB_PORT=3306

# If you use external PostgreSQL:
# DB_ENGINE=postgresql
# DB_NAME=
# DB_USER=
# DB_PWD=
# DB_HOST=
# DB_PORT=5432

# Shared classroom gate. Empty string disables the gate.
SITE_ACCESS_PASSWORD=

# Proxy hops that append X-Forwarded-For (usually 0 on PythonAnywhere).
TRUSTED_PROXY_COUNT=0

# SMTP — without EMAIL_HOST, mail goes to the console only.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@localhost
ADMIN_EMAIL=admin@localhost
FEEDBACK_TO_EMAIL=admin@localhost

# Notebook sandbox wall-clock seconds.
EXERCISE_RUN_TIMEOUT=45
EXERCISE_RUN_RATE_LIMIT=30
EXERCISE_RUN_RATE_WINDOW=60

# PythonAnywhere: set these so notebooks run inside the web worker.
# (Web apps often expose uWSGI as sys.executable, which breaks subprocess sandboxes.)
EXERCISE_INLINE_SANDBOX=1
EXERCISE_ENABLE_RESOURCE_LIMITS=0
